{
  "name": "comp3810-campus-loans",
  "version": "1.0.0",
  "private": true,
  "description": "Campus equipment loan register using Express, EJS and MongoDB Atlas",
  "main": "server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/seed_data.js",
