<%- include('partials/header') %>
<%
  const id = String(loan._id);
  const formatDate = (value) => value ? value : '—';
%>
<a class="back-link" href="/loans"><span aria-hidden="true">←</span> Back to records</a>
<section class="page-heading">
  <div>
    <p class="eyebrow">LOAN DETAILS</p>
    <h1><%= loan.itemName %> (<%= loan.itemCode %>)</h1>
  </div>
  <a class="button button-primary" href="/loans/<%= id %>/edit">Edit Record</a>
</section>

<% if (loan.overdue) { %>
  <div class="alert alert-warning" role="status"><strong>This loan is overdue</strong><p>The due date was <%= loan.dueDate %>. Please contact the borrower to arrange a return.</p></div>
<% } %>

<section class="panel detail-panel">
  <div class="section-heading">
    <h2>Equipment Information</h2>
    <span class="badge badge-<%= loan.status %>"><%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %></span>
  </div>
  <dl class="detail-grid">
    <div><dt>Equipment Code</dt><dd><%= loan.itemCode %></dd></div>
    <div><dt>Equipment Name</dt><dd><%= loan.itemName %></dd></div>
    <div><dt>Category</dt><dd><%= loan.category.charAt(0).toUpperCase() + loan.category.slice(1) %></dd></div>
    <div><dt>Condition</dt><dd><%= loan.condition.charAt(0).toUpperCase() + loan.condition.slice(1) %></dd></div>
    <div class="detail-wide"><dt>Notes</dt><dd><%= loan.notes || '—' %></dd></div>
  </dl>
</section>

<% if (loan.status === 'borrowed') { %>
<section class="panel detail-panel" style="margin-top: 20px;">
  <div class="section-heading"><h2>Borrower Information</h2></div>
  <dl class="detail-grid">
    <div><dt>Borrower</dt><dd><%= loan.borrower %></dd></div>
    <div><dt>Phone</dt><dd><%= loan.contactPhone %></dd></div>
    <div><dt>Email</dt><dd><%= loan.contactEmail %></dd></div>
    <div><dt>Borrow Date</dt><dd><%= loan.borrowDate %></dd></div>
    <div><dt>Due Date</dt><dd><%= loan.dueDate %></dd></div>
  </dl>
</section>
<% } %>

<section class="delete-section" aria-label="Delete record">
  <div><h2>Delete Record</h2><p class="muted small">Only use this to remove incorrect records. For normal returns, change the status instead.</p></div>
  <form action="/loans/<%= id %>/delete" method="post" data-confirm="Are you sure you want to delete the loan record for <%= loan.itemName %>? This cannot be undone.">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="button button-danger" type="submit">Delete this record</button>
  </form>
</section>
<%- include('partials/footer') %>