<%- include('partials/header') %>
<section class="login-layout" aria-labelledby="login-heading">
  <div class="login-intro">
    <p class="eyebrow">CAMPUS EQUIPMENT / LOAN MANAGEMENT</p>
    <h1>Every loan,<br>fully recorded.</h1>
    <p class="intro-copy">Manage campus equipment loans from checkout to return. Keep equipment flow clear and trackable.</p>
  </div>
  <div class="panel login-panel">
    <p class="eyebrow">WELCOME BACK</p>
    <h2 id="login-heading">Sign in to management system</h2>
    <p class="muted">Please use the account created by the administrator.</p>
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><strong>Login failed</strong><p><%= error %></p></div>
    <% } %>
    <form action="/login" method="post" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" value="<%= username || '' %>" autocomplete="username" maxlength="80" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="button button-primary button-full" type="submit">Login</button>
    </form>
  </div>
</section>
<%- include('partials/footer') %>
