<%- include('partials/header') %>
<% const isEdit = action !== '/loans'; %>
<a class="back-link" href="/loans"><span aria-hidden="true">←</span> Back to records</a>
<section class="page-heading">
  <div>
    <p class="eyebrow"><%= isEdit ? 'UPDATE INFO' : 'REGISTER EQUIPMENT' %></p>
    <h1><%= isEdit ? 'Edit Loan Record' : 'New Loan Record' %></h1>
  </div>
</section>

<div class="form-layout">
  <section class="panel form-panel">
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><strong>Failed to save</strong><p><%= error %></p></div>
    <% } %>
    
    <form action="<%= action %>" method="post" class="form-stack" id="equipmentForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="form-columns">
        <div class="field">
          <label for="itemCode">Equipment Code (Required)</label>
          <input id="itemCode" name="itemCode" type="text" value="<%= loan?.itemCode || '' %>" placeholder="e.g., CAM-001" required <%= isEdit ? 'readonly' : '' %>>
        </div>
        <div class="field">
          <label for="itemName">Equipment Name (Required)</label>
          <input id="itemName" name="itemName" type="text" value="<%= loan?.itemName || '' %>" placeholder="e.g., Canon R50" required maxlength="80">
        </div>
      </div>

      <div class="form-columns">
        <div class="field">
          <label for="category">Category</label>
          <select id="category" name="category" required>
            <option value="tablet" <%= loan?.category === 'tablet' ? 'selected' : '' %>>Tablet</option>
            <option value="laptop" <%= loan?.category === 'laptop' ? 'selected' : '' %>>Laptop</option>
            <option value="camera" <%= loan?.category === 'camera' ? 'selected' : '' %>>Camera</option>
          </select>
        </div>
        <div class="field">
          <label for="condition">Condition</label>
          <select id="condition" name="condition" required>
            <option value="good" <%= loan?.condition === 'good' ? 'selected' : '' %>>Good</option>
            <option value="damaged" <%= loan?.condition === 'damaged' ? 'selected' : '' %>>Damaged</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status" required>
          <option value="available" <%= loan?.status === 'available' ? 'selected' : '' %>>Available</option>
          <option value="borrowed" <%= loan?.status === 'borrowed' ? 'selected' : '' %>>Borrowed</option>
          <option value="unavailable" <%= loan?.status === 'unavailable' ? 'selected' : '' %>>Unavailable</option>
        </select>
        <span class="field-help" id="status-help">When condition is set to "Damaged", the status will automatically lock to "Unavailable".</span>
      </div>

      <div class="field">
        <label for="notes">Notes (Optional)</label>
        <textarea id="notes" name="notes" rows="3" maxlength="300"><%= loan?.notes || '' %></textarea>
      </div>

      <!-- Borrower Info: Only shown when status is 'borrowed' -->
      <div id="borrow-fields" style="display: none;">
        <h3 style="margin-top:20px; margin-bottom:15px; font-size:16px; border-bottom: 1px solid var(--line); padding-bottom: 10px;">Borrower Information (Required for checkout)</h3>
        <div class="form-columns">
          <div class="field">
            <label for="borrower">Borrower</label>
            <input id="borrower" name="borrower" type="text" value="<%= loan?.borrower || '' %>">
          </div>
          <div class="field">
            <label for="contactPhone">Phone</label>
            <input id="contactPhone" name="contactPhone" type="text" value="<%= loan?.contactPhone || '' %>" placeholder="e.g., +852 9123 4567">
          </div>
        </div>
        <div class="field">
          <label for="contactEmail">Email</label>
          <input id="contactEmail" name="contactEmail" type="email" value="<%= loan?.contactEmail || '' %>">
        </div>
        <div class="form-columns">
          <div class="field">
            <label for="borrowDate">Borrow Date</label>
            <input id="borrowDate" name="borrowDate" type="date" value="<%= loan?.borrowDate || '' %>">
          </div>
          <div class="field">
            <label for="dueDate">Due Date (1-14 days later)</label>
            <input id="dueDate" name="dueDate" type="date" value="<%= loan?.dueDate || '' %>">
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button class="button button-primary" type="submit"><%= isEdit ? 'Save Changes' : 'Create Record' %></button>
        <a class="button button-secondary" href="/loans">Cancel</a>
      </div>
    </form>
  </section>
</div>

<%- include('partials/footer') %>