<%- include('partials/header') %>
<section class="page-heading">
  <div>
    <p class="eyebrow">EQUIPMENT MANAGEMENT</p>
    <h1>Loan Records</h1>
    <p class="muted">View equipment location and track return progress.</p>
  </div>
  <a class="button button-primary" href="/loans/new"><span aria-hidden="true">＋</span> New Equipment</a>
</section>

<% if (notice) { %>
  <div class="alert alert-success" role="status"><%= notice %></div>
<% } %>

<section class="panel records-panel">
  <!-- Search Form -->
  <form class="search-form" method="get" action="/loans" role="search">
    <div class="field search-keyword">
      <label for="q">Keyword</label>
      <input id="q" name="q" type="search" value="<%= query.q || '' %>" placeholder="Search item code or name" maxlength="80">
    </div>
    <div class="field">
      <label for="category">Category</label>
      <select id="category" name="category">
        <option value="">All Categories</option>
        <option value="tablet" <%= query.category === 'tablet' ? 'selected' : '' %>>Tablet</option>
        <option value="laptop" <%= query.category === 'laptop' ? 'selected' : '' %>>Laptop</option>
        <option value="camera" <%= query.category === 'camera' ? 'selected' : '' %>>Camera</option>
      </select>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">All Status</option>
        <option value="available" <%= query.status === 'available' ? 'selected' : '' %>>Available</option>
        <option value="borrowed" <%= query.status === 'borrowed' ? 'selected' : '' %>>Borrowed</option>
        <option value="unavailable" <%= query.status === 'unavailable' ? 'selected' : '' %>>Unavailable</option>
      </select>
    </div>
    <div class="search-actions">
      <button class="button button-primary" type="submit">Search</button>
      <a class="button button-secondary" href="/loans">Reset</a>
    </div>
  </form>

  <!-- Record List -->
  <% if (!loans.length) { %>
    <div class="empty-state">
      <h3><%= query.q || query.category || query.status ? 'No matching records found' : 'No equipment records yet' %></h3>
      <p class="muted"><%= query.q || query.category || query.status ? 'Try different keywords, or reset filters.' : 'Register the first equipment to start managing.' %></p>
      <a class="button button-secondary" href="<%= query.q || query.category || query.status ? '/loans' : '/loans/new' %>"><%= query.q || query.category || query.status ? 'View All' : 'New Equipment' %></a>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Code</th><th>Name</th><th>Category</th><th>Condition</th><th>Status</th><th>Borrower</th><th>Due Date</th><th class="actions-heading">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (const loan of loans) { const id = String(loan._id); %>
            <tr class="<%= loan.status === 'unavailable' ? 'row-disabled' : '' %>">
              <td><strong><%= loan.itemCode %></strong></td>
              <td><%= loan.itemName %></td>
              <td><%= loan.category.charAt(0).toUpperCase() + loan.category.slice(1) %></td>
              <td><%= loan.condition.charAt(0).toUpperCase() + loan.condition.slice(1) %></td>
              <td>
                <span class="badge badge-<%= loan.status %>"><%= loan.status.charAt(0).toUpperCase() + loan.status.slice(1) %></span>
                <% if (loan.status === 'borrowed' && loan.overdue) { %>
                  <span class="overdue-text">Overdue</span>
                <% } %>
              </td>
              <td><%= loan.borrower || '—' %></td>
              <td class="date-cell"><%= loan.dueDate || '—' %></td>
              <td>
                <div class="row-actions">
                  <a href="/loans/<%= id %>">View</a>
                  <a href="/loans/<%= id %>/edit">Edit</a>
                  <form action="/loans/<%= id %>/delete" method="post" data-confirm="Are you sure you want to delete <%= loan.itemName %>?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="text-button text-danger" type="submit">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>